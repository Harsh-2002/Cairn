---
interface Props {
  code: string;
  label?: string;
}
const { code, label } = Astro.props;
---

<div class="codeblock">
  {label && <span class="codeblock__label">{label}</span>}
  <div class="codeblock__body">
    <pre><code>{code.trim()}</code></pre>
    <button
      class="codeblock__copy"
      type="button"
      data-copy={code.trim()}
      aria-label="Copy to clipboard">Copy</button
    >
  </div>
</div>

<script>
  // Copy handler (one delegated listener for every block on the page).
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>(".codeblock__copy");
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy || "");
      const prev = btn.textContent;
      btn.textContent = "Copied";
      btn.classList.add("is-copied");
      setTimeout(() => {
        btn.textContent = prev;
        btn.classList.remove("is-copied");
      }, 1400);
    } catch {
      /* clipboard blocked — no-op */
    }
  });

  // Console scripts don't wrap and don't scroll: a long line clips, and Copy hands over
  // the full text. Flag the blocks that actually clip so the right-edge fade only shows
  // where there is more than fits.
  function markClipped() {
    document.querySelectorAll<HTMLElement>(".codeblock__body").forEach((body) => {
      const pre = body.querySelector("pre");
      if (pre) body.toggleAttribute("data-clipped", pre.scrollWidth > pre.clientWidth + 1);
    });
  }
  markClipped();
  addEventListener("resize", markClipped);
</script>

<style>
  .codeblock {
    margin-block: var(--space-4);
    max-width: 100%;
  }
  .codeblock__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-bottom: var(--space-2);
  }
  .codeblock__body {
    position: relative;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    overflow: hidden; /* clip long lines to the rounded box — no scrollbar on any device */
  }
  pre {
    margin: 0;
    padding: 0.9rem 1rem;
    padding-right: 4.5rem;
    /* Keep each command on its own line, exactly as typed. Long lines clip instead of
       wrapping or scrolling; the Copy button carries the full, exact text. */
    white-space: pre;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--fg);
    font-variant-numeric: slashed-zero;
  }
  /* A soft right-edge fade shown only when a line is clipped — signals there's more,
     and that Copy grabs all of it. */
  .codeblock__body[data-clipped]::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 3.5rem;
    background: linear-gradient(to right, transparent, var(--bg-subtle));
    pointer-events: none;
  }
  .codeblock__copy {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 1; /* above the fade */
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    background: var(--bg);
    border: 1px solid var(--hairline-bold);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .codeblock__copy:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .codeblock__copy.is-copied {
    color: var(--fg);
    border-color: var(--fg);
  }
</style>
