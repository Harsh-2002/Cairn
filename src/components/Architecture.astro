---
import Section from "./Section.astro";

// A low-level view of Cairn's request/data path and its durability contract, grounded in
// the spec (data plane 6–7, metadata 11–12, durability 8–10). No images: hairline tiers +
// mono chips + a one-line note per tier that reflow at every width. Top-to-bottom is flow.
const layers = [
  {
    tier: "Clients",
    nodes: ["S3 SDKs", "AWS CLI", "Cairn CLI", "Browser console"],
    desc: "Anything that speaks S3 can connect. The console and CLI use the same API.",
  },
  {
    tier: "Request path",
    nodes: ["authenticate", "check policy", "stream the body", "encrypt"],
    desc: "Requests arrive on :7373 (S3 and admin) or :7374 (console). They are authenticated, checked against policy, then streamed to disk. Encryption happens on the way in and out.",
  },
  {
    tier: "Index",
    nodes: ["one writer", "parallel reads", "SQLite index", "settings + activity"],
    desc: "A small SQLite database holds the index, settings and activity log. One writer keeps writes ordered; reads run in parallel.",
  },
  {
    tier: "Files",
    nodes: ["normal files", "flush to disk", "atomic move", "checksum"],
    desc: "Objects are files. Cairn flushes each file to disk before it records the object, so the file is the source of truth.",
  },
  {
    tier: "Background",
    nodes: ["replication", "lifecycle + TTL", "webhooks", "cleanup", "integrity check"],
    desc: "Replication, expiry, webhooks and cleanup run in the background, driven by a durable queue.",
  },
];

// The write path is an ordered contract: the file is durable before the
// database records it. The database is an index; the object file is the truth.
const steps = [
  "write a temp file",
  "flush to disk",
  "move into place",
  "record it",
  "clean up",
];
---

<Section eyebrow="Architecture" title="How it works">
  <p>
    Cairn is one process, one data folder and one small database. Requests come in through two
    ports, are checked, and are written as normal files.
  </p>

  <div class="arch">
    {
      layers.map((l, i) => (
        <>
          {i > 0 && <span class="arch__link" aria-hidden="true" />}
          <div class="arch__layer">
            <span class="arch__tier">{l.tier}</span>
            <div class="arch__body">
              <div class="arch__nodes">
                {l.nodes.map((n) => (
                  <span class="chip">{n}</span>
                ))}
              </div>
              <p class="arch__desc">{l.desc}</p>
            </div>
          </div>
        </>
      ))
    }
  </div>

  <p class="arch__lead">
    Cairn writes the file first, flushes it, and only then says the write succeeded. The database
    row is an index; if it is lost, startup rebuilds it from the files. That is why an acknowledged
    write survives a crash.
  </p>

  <div class="writepath" role="list" aria-label="Durable write path, in order">
    {
      steps.map((s, i) => (
        <>
          {i > 0 && (
            <span class="writepath__arrow" aria-hidden="true">
              →
            </span>
          )}
          <span role="listitem" class="writepath__step">
            <span class="writepath__n">{i + 1}</span>
            {s}
          </span>
        </>
      ))
    }
  </div>
  <p class="writepath__note">
    The object is safe before the database row exists. New objects carry a BLAKE3 checksum; older
    objects keep SHA-256. The storage format is one-way after v42 — restore a snapshot to go back.
  </p>
</Section>

<style>
  /* --- Layered flow diagram: each tier is a full-width hairline row, so it reflows
         cleanly and never scrolls sideways. Top-to-bottom implies the request flow. --- */
  .arch {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
  }
  .arch__layer {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem 0.9rem;
    align-items: start;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.8rem 0.9rem;
    background: var(--bg-subtle);
  }
  .arch__tier {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
    padding-top: 0.3rem;
  }
  .arch__nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
    background: var(--bg);
    border: 1px solid var(--hairline-bold);
    border-radius: 5px;
    padding: 0.25rem 0.55rem;
  }
  .arch__desc {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--fg-muted);
    margin-top: 0.55rem;
    max-width: 52ch;
  }
  /* A centered hairline between tiers, in the page's own 1px-rule language. */
  .arch__link {
    width: 1px;
    height: var(--space-4);
    margin-inline: auto;
    background: var(--hairline-bold);
  }

  /* --- The durable write path: an ordered row of numbered steps that wraps instead
         of scrolling. The arrows are flow, not content (aria-hidden). --- */
  .arch__lead {
    margin-top: var(--space-5);
  }
  .writepath {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.35rem;
    margin-top: var(--space-3);
  }
  .writepath__step {
    display: inline-flex;
    align-items: center;
    gap: 0.55ch;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.3rem 0.6rem;
  }
  .writepath__n {
    font-size: 0.74em;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }
  .writepath__arrow {
    color: var(--fg-faint);
    font-family: var(--font-mono);
  }
  .writepath__note {
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-top: var(--space-3);
  }

  /* Narrow screens: tier label stacks above its nodes; chips wrap. No horizontal scroll. */
  @media (max-width: 34rem) {
    .arch__layer {
      grid-template-columns: 1fr;
    }
    .arch__tier {
      padding-top: 0;
    }
  }
</style>
