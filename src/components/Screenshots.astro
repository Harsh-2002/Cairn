---
import Section from "./Section.astro";

// The console gallery. The rest of this page is typography-only on purpose; this section is the one
// place an image earns its keep, because "the console is the product" is a claim best settled by
// showing it. Every shot is a real screen from a running node.
//
// Images are WebP at 1600px (~70 KB each), lazy-loaded below the hero, with intrinsic dimensions set
// so nothing shifts as they arrive.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const W = 1600;
const H = 1047;

const hero = {
  slug: "overview-dashboard",
  caption: "Buckets, objects, storage and node health at a glance.",
};

const shots = [
  {
    slug: "bucket-browser",
    caption: "Browse, preview, share or delete objects.",
  },
  {
    slug: "object-preview",
    caption: "Preview images, video, PDFs, Markdown, JSON and text in place.",
  },
  {
    slug: "bucket-settings-access",
    caption: "Edit bucket policy, ownership and public-access settings.",
  },
  {
    slug: "bucket-settings-data-protection",
    caption: "Encryption, Object Lock and lifecycle rules per bucket.",
  },
  {
    slug: "credentials-temporary",
    caption: "Create short-lived, scoped credentials.",
  },
  {
    slug: "metrics-charts",
    caption: "Requests, errors, throughput and latency over time.",
  },
  {
    slug: "tags-browser",
    caption: "See every tag in use and the objects that carry it.",
  },
  {
    slug: "activity-audit-log",
    caption: "An audit log of admin actions, with actor, bucket and key.",
  },
  {
    slug: "bucket-settings-replication",
    caption: "Replication rules and remote targets.",
  },
];
---

<Section eyebrow="Console" title="What it looks like">
  <p>
    The console ships in the same binary. These are real screens from a running node — browse and
    share objects, manage buckets and users, and check health and activity.
  </p>

  <figure class="shot shot--hero">
    <img
      src={`${base}screenshots/${hero.slug}.webp`}
      alt={hero.caption}
      width={W}
      height={H}
      loading="eager"
      decoding="async"
    />
    <figcaption>{hero.caption}</figcaption>
  </figure>

  <div class="grid">
    {
      shots.map((s) => (
        <figure class="shot">
          <img
            src={`${base}screenshots/${s.slug}.webp`}
            alt={s.caption}
            width={W}
            height={H}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</Section>

<style>
  .shot {
    margin: 0;
  }
  .shot img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }
  .shot figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--fg-faint);
    max-width: 60ch;
  }
  .shot--hero {
    margin-top: var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-5) var(--space-4);
    margin-top: var(--space-5);
  }
</style>
