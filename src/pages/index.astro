---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Architecture from "../components/Architecture.astro";
import Screenshots from "../components/Screenshots.astro";

const repo = "https://github.com/Harsh-2002/Cairn";
const docs = `${repo}/blob/main/docs`;

const install = "curl -fsSL https://raw.githubusercontent.com/Harsh-2002/Cairn/main/install.sh | sudo sh";

const envFile = `(umask 077; set -C
  printf '%s\\n' \\
    "CAIRN_MASTER_KEY=$(openssl rand -hex 32)" \\
    "CAIRN_ROOT_ACCESS_KEY=cairn" \\
    "CAIRN_ROOT_SECRET_KEY=$(openssl rand -hex 24)" \\
    > cairn.env
)`;

const dockerRun = `docker run -d --name cairn \\
  -p 127.0.0.1:7373:7373 -p 127.0.0.1:7374:7374 \\
  -v cairn-data:/data --env-file ./cairn.env \\
  ghcr.io/harsh-2002/cairn:latest`;

const awsConfig = "aws configure --profile cairn";

const awsUse = `# A short alias for the endpoint
alias s3="aws --profile cairn --endpoint-url http://localhost:7373"

s3 mb s3://demo                        # create a bucket
s3 cp ./report.pdf s3://demo/          # upload a file
s3 ls s3://demo/                       # list objects
s3 cp s3://demo/report.pdf ./out.pdf   # download it back
s3 sync ./site s3://demo/site          # sync a directory
s3 presign s3://demo/report.pdf --expires-in 3600   # shareable link`;

// The common configuration surface (the full CAIRN_* reference is in docs/configuration.md).
const envs = [
  {
    name: "CAIRN_MASTER_KEY",
    def: "a dev key (insecure)",
    desc: "A 32-byte hex key for encrypting secrets. Set it once and keep it safe; the built-in key is for local tests only.",
  },
  {
    name: "CAIRN_ROOT_ACCESS_KEY",
    def: "cairn",
    desc: "The admin access key. The default is fine for local use; change it for a public node.",
  },
  {
    name: "CAIRN_ROOT_SECRET_KEY",
    def: "cairnadmin",
    desc: "The admin secret. Change it before exposing the node.",
  },
  {
    name: "CAIRN_API_ADDR",
    def: "0.0.0.0:7373",
    desc: "S3 and the admin API. Health, metrics and temporary credentials live here too.",
  },
  {
    name: "CAIRN_CONSOLE_ADDR",
    def: "0.0.0.0:7374",
    desc: "The web console. Set to off for API-only operation.",
  },
  {
    name: "CAIRN_DATA_DIR",
    def: "./data",
    desc: "Where object files live; /data in the container.",
  },
  {
    name: "CAIRN_DB_PATH",
    def: "./data/cairn.db",
    desc: "The SQLite index; /data/cairn.db in the container.",
  },
  {
    name: "CAIRN_TLS_CERT_PATH / _KEY_PATH",
    def: "unset",
    desc: "Set both for built-in TLS; otherwise use a TLS-terminating proxy.",
  },
  {
    name: "CAIRN_ENCRYPT_AT_REST",
    def: "off",
    desc: "Encrypt every object on disk, even when the client does not ask for it.",
  },
  {
    name: "CAIRN_META_SYNCHRONOUS",
    def: "full",
    desc: "full flushes the index before saying yes. normal is faster but can lose recent admin or settings changes; objects are rebuilt from disk.",
  },
];

const features = [
  {
    h: "S3 API",
    p: "Buckets, objects, versions, large uploads, range reads, checksums, tags, lifecycle, Object Lock and shareable links. Standard S3 clients work unchanged.",
  },
  {
    h: "Web console",
    p: "Browse, upload, preview and share from the browser. Manage buckets, users and settings. Turn it off and the API still works.",
  },
  {
    h: "Access control",
    p: "Bucket and user policies, access lists (ACLs), Block Public Access, ownership controls and temporary credentials.",
  },
  {
    h: "Security & encryption",
    p: "TLS, encrypted secrets, and server-side encryption at rest. The AWS KMS option is a label over the node key, not a separate key service.",
  },
  {
    h: "Durability",
    p: "Files are flushed to disk before Cairn says yes. The database catches up; if it is lost, startup rebuilds it from the files.",
  },
  {
    h: "Storage efficiency",
    p: "Optional compression that still supports range reads. Large uploads can finish faster on XFS or btrfs.",
  },
  {
    h: "Operations",
    p: "Metrics, health checks, replication, webhooks, import, quotas and object expiry. Backup and restore from the CLI.",
  },
];

---

<Base>
  {/* 1 — Hero */}
  <section class="hero wrap">
    <h1>
      Self-hosted, S3-compatible<br /> object storage.
    </h1>
    <p class="lead">
      Keep files, backups and app data on your own server. Cairn speaks the S3 API, stores
      everything as normal files, and runs as one binary — no external database or cluster.
    </p>
    <div class="cta">
      <a class="btn" href="#get-started">Get started</a>
      <a class="btn btn--ghost" href={`${docs}/overview.md`}>Documentation</a>
      <a class="btn btn--ghost" href={repo}>GitHub</a>
    </div>
  </section>

  {/* 2 — What it is */}
  <Section eyebrow="What it is" title="A single-node object store that speaks S3">
    <p>
      Point any S3 client at it — the AWS CLI, an SDK, or the built-in console — and it keeps your
      data as files on a normal disk. A small SQLite database holds the index and settings, not the
      data itself.
    </p>
    <dl class="points">
      <div>
        <dt>Your files, your disk</dt>
        <dd>
          Objects are ordinary files on disk, not a proprietary store. Cairn handles compression and
          encryption; use S3 or the CLI to export the original bytes.
        </dd>
      </div>
      <div>
        <dt>A small database, not a server</dt>
        <dd>
          SQLite holds the index and settings. If the index is lost, Cairn rebuilds it from the
          object files at startup.
        </dd>
      </div>
      <div>
        <dt>One binary</dt>
        <dd>Server, console and CLI in one file. A distroless container image is published too.</dd>
      </div>
    </dl>
  </Section>

  {/* 3 — Architecture (low-level design) */}
  <Architecture />

  {/* 4 — Features */}
  <Section eyebrow="Features" title="What it does">
    <dl class="points points--features">
      {
        features.map((f) => (
          <div>
            <dt>{f.h}</dt>
            <dd>{f.p}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {/* 5 — Console gallery */}
  <Screenshots />

  {/* 6 — Performance */}
  <Section eyebrow="Performance" title="Measure the workload you run">
    <p>
      We compare Cairn with RustFS and MinIO&apos;s <code>warp</code> on the same host, with the same
      workload. Results depend on the hardware, object size and durability settings, so read the
      ratios, not just the absolute numbers.
    </p>
    <p>
      On our shared test host, Cairn was faster than RustFS on every equal-durability workload:{" "}
      <strong>2.24×</strong> on 4 KiB writes, <strong>1.14×</strong> on 1 MiB writes,{" "}
      <strong>1.92×</strong> on 1 MiB reads, <strong>5.33×</strong> on listing 1,000 keys,{" "}
      <strong>1.07×</strong> on multipart uploads, and <strong>5.17×</strong> on versioned deletes.
    </p>
    <p class="note">
      The unversioned delete row is not an equal-durability comparison. The{" "}
      <a class="link" href={`${docs}/benchmarks.md`}>benchmark record</a> has the method,
      limitations and reproduction commands; the{" "}
      <a class="link" href={`${docs}/scaling-limits.md`}>scaling guide</a> covers sizing limits.
    </p>
  </Section>

  {/* 6 — Why Cairn */}
  <Section eyebrow="Why Cairn" title="Built to replace a single-node MinIO">
    <p>
      If you run a single-node MinIO, Cairn is a simpler replacement: one binary, normal files, a
      built-in console and async replication — without a cluster to operate.
    </p>
    <dl class="points">
      <div>
        <dt>Written in Rust</dt>
        <dd>Fast, predictable and memory-safe.</dd>
      </div>
      <div>
        <dt>Self-contained</dt>
        <dd>Console and CLI live inside the binary; nothing extra to deploy.</dd>
      </div>
      <div>
        <dt>Honest about limits</dt>
        <dd>Single-node by design. The trade-offs are written down, not hidden.</dd>
      </div>
    </dl>
  </Section>

  {/* 7 — Scope */}
  <Section eyebrow="Scope" title="Single-node by design">
    <p>That is deliberate — it keeps the system small and easy to run.</p>
    <ul class="scope">
      <li>
        <strong>Need a copy elsewhere?</strong> Use async bucket replication. It is not a cluster, and
        it does not fail over automatically.
      </li>
      <li>
        <strong>Disk redundancy</strong> is your filesystem&apos;s job: ZFS, RAID or a replicated
        volume.
      </li>
      <li>
        <strong>Supported:</strong> Linux 5.6+ on x86_64 or arm64. XFS is recommended; ext4 works.
        Backups and a tested restore are required.
      </li>
      <li>
        <strong>Format:</strong> new objects use a fast BLAKE3 checksum; older objects keep SHA-256.
        The format is one-way after v42 — restore a snapshot to go back.
      </li>
      <li>
        <strong>Not built in:</strong> login rate limiting. Put a proxy or firewall in front of a
        public endpoint. The AWS KMS option is a label, not a separate key service.
      </li>
      <li>
        <strong>Best for</strong> homelabs and small-to-mid production.
      </li>
    </ul>
    <p class="note">
      Full supported scope and operational limits are in the{" "}
      <a class="link" href={`${docs}/support.md`}>support statement</a>.
    </p>
  </Section>

  {/* 8 — Get started / deploy */}
  <Section eyebrow="Get started" title="Deploy Cairn" id="get-started">
    <p>
      Requires Linux 5.6+ on <code>x86_64</code> or <code>arm64</code>. The installer sets up Docker
      or a host service, creates credentials and a key, and keeps both ports on localhost.
    </p>
    <CodeBlock code={install} />

    <h3 class="deploy__h">Run with Docker</h3>
    <p>
      Create <code>cairn.env</code> once. It holds the master key and admin secret; keep it out of
      version control and reuse it with the data volume.
    </p>
    <CodeBlock code={envFile} />
    <p>The image runs as nonroot and stores data in <code>/data</code>. Start it:</p>
    <CodeBlock code={dockerRun} />
    <p class="note">
      Open <code>http://localhost:7374</code> and sign in with <code>cairn</code> and the secret
      from <code>cairn.env</code>. For remote access, use TLS and the{" "}
      <a class="link" href={`${docs}/operations.md#api-and-console-ingress`}>ingress guide</a>.
      Upgrading? Follow the{" "}
      <a class="link" href={`${docs}/upgrade-rollback.md`}>upgrade and rollback guide</a>.
    </p>
  </Section>

  {/* 9 — Configuration */}
  <Section eyebrow="Configuration" title="Configure with the environment">
    <p>
      Cairn uses <code>CAIRN_*</code> environment variables: no config file, no server flags.
      Unknown names or bad values fail at startup, and <code>cairn validate-config</code> checks the
      environment first.
    </p>
    <div class="table-scroll">
      <table class="envtable">
        <thead>
          <tr>
            <th scope="col">Variable</th>
            <th scope="col">Default</th>
            <th scope="col">What it&apos;s for</th>
          </tr>
        </thead>
        <tbody>
          {
            envs.map((e) => (
              <tr>
                <td class="envtable__name">{e.name}</td>
                <td class="envtable__def">{e.def}</td>
                <td class="envtable__desc">{e.desc}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="note">
      That&apos;s the common set. Replication workers, object TTL, scrubbing, lifecycle, webhooks,
      KMS and sharding are in the full{" "}
      <a class="link" href={`${docs}/configuration.md`}><code>CAIRN_*</code> reference</a>.
    </p>
    <p class="note">
      Upgrading? Old listener and URL names are rejected; follow the{" "}
      <a class="link" href={`${docs}/upgrade-rollback.md#api-and-console-configuration-migration`}>
      configuration migration</a>. The CLI uses <code>--api-endpoint</code> or{" "}
      <code>CAIRN_API_ENDPOINT</code>.
    </p>
  </Section>

  {/* 10 — Using the AWS CLI */}
  <Section eyebrow="Usage" title="Use it with the AWS CLI">
    <p>
      The <code>aws</code> CLI and the AWS SDKs work unchanged — just point them at the endpoint.
      Configure a profile with the keys from your installer or <code>cairn.env</code>:
    </p>
    <CodeBlock code={awsConfig} />
    <p>Then use normal bucket and object commands:</p>
    <CodeBlock code={awsUse} />
    <p class="note">
      Multipart uploads, range reads, versions, tags and presigned links work. See the{" "}
      <a class="link" href={`${docs}/s3-api-matrix.md`}>S3 API matrix</a> for the exact surface.
    </p>
  </Section>

  {/* 11 — Release policy */}
  <Section eyebrow="Releases" title="One version, always the latest">
    <p>
      Cairn uses calendar versions (<code>vYYYY.MM.DD</code>). Older releases and tags are retired,
      so the latest release is the supported one. Releases are cut manually, only after CI is green.
    </p>
    <p>
      Binaries and the container image are signed, with checksums, a software bill of materials
      (SBOM) and build provenance. See the{" "}
      <a class="link" href={`${repo}/blob/main/SECURITY.md#verifying-release-artifacts`}>
      verification guide</a> before deploying.
    </p>
    <p>
      Current status: <strong>1.0 release candidate</strong> for a single node with backups and a
      tested restore. The evidence and limits are in the{" "}
      <a class="link" href={`${docs}/stability-2026-11-05.md`}>stability record</a> and{" "}
      <a class="link" href={`${docs}/support.md`}>support statement</a>. The binary reports its
      version and checks for updates hourly; turn that off with{" "}
      <code>CAIRN_UPDATE_CHECK_ENABLED=false</code>.
    </p>
  </Section>

  {/* 12 — Footer */}
  <footer class="site-footer wrap">
    <p class="site-footer__tag">Cairn — self-hosted, S3-compatible object storage.</p>
    <p>Apache-2.0. The license is permanent; there is no enterprise edition or open-core split.</p>
    <nav class="linkrow" aria-label="Documentation">
      <a class="link" href={`${docs}/overview.md`}>Overview</a>
      <a class="link" href={`${docs}/data-plane.md`}>Architecture</a>
      <a class="link" href={`${docs}/configuration.md`}>Configuration</a>
      <a class="link" href={`${docs}/s3-api-matrix.md`}>S3 API matrix</a>
      <a class="link" href={`${docs}/operations.md`}>Operations</a>
      <a class="link" href={`${docs}/support.md`}>Support &amp; scope</a>
    </nav>
    <nav class="linkrow linkrow--muted" aria-label="Project">
      <a class="link" href={repo}>GitHub</a>
      <a class="link" href={`${repo}/releases`}>Releases</a>
      <a class="link" href={`${repo}/pkgs/container/cairn`}>Container image</a>
      <a class="link" href={`${repo}/blob/main/SECURITY.md`}>Security</a>
      <a class="link" href={`${repo}/blob/main/LICENSE`}>License</a>
    </nav>
  </footer>
</Base>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }
  .hero h1 {
    font-size: var(--step-hero);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }
  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 60ch;
    margin-bottom: var(--space-4);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-4);
  }

  /* small, faint note under a code block or list */
  .note {
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-top: 0.6rem;
  }
  .note .link {
    color: var(--fg-muted);
  }
  .note .link:hover {
    color: var(--fg);
  }

  /* definition-list feature/point blocks */
  .points {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .points dt {
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 0.15rem;
  }
  .points dd {
    margin: 0;
    color: var(--fg-muted);
    max-width: var(--measure);
  }
  .points--features {
    gap: var(--space-5);
  }

  /* horizontally contained configuration table */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-block: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .scope {
    margin-top: var(--space-3);
  }

  /* deploy sub-headings */
  .deploy__h {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  /* configuration reference table. No min-width: the description column wraps so the
     table fits any width; the bordered .table-scroll wrapper catches the rare overflow. */
  table.envtable {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .envtable th,
  .envtable td {
    padding: 0.55rem 0.85rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hairline);
  }
  .envtable thead th {
    font-weight: 500;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--bg-subtle);
    white-space: nowrap;
  }
  .envtable tbody tr:last-child td {
    border-bottom: 0;
  }
  .envtable__name {
    font-family: var(--font-mono);
    color: var(--fg);
    white-space: nowrap; /* keep each variable on one line on desktop (breaks on mobile below) */
  }
  .envtable__def {
    font-family: var(--font-mono);
    color: var(--fg-faint);
  }
  .envtable__desc {
    color: var(--fg-muted);
    min-width: 15ch;
  }

  .linkrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .linkrow a {
    color: var(--fg-muted);
  }
  .linkrow a:hover {
    color: var(--fg);
  }
  .linkrow--muted a {
    color: var(--fg-faint);
  }

  .site-footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--hairline);
    margin-top: var(--space-4);
  }
  .site-footer__tag {
    color: var(--fg);
    font-weight: 500;
    margin-bottom: 0.4rem;
  }
  .site-footer p {
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  @media (max-width: 34rem) {
    .hero h1 {
      font-size: 2.1rem;
    }
    .hero h1 br {
      display: none;
    }
    /* On phones, let long variable names break and tighten padding so the whole table
       fits the viewport without scrolling. */
    /* On phones, stack each row into a readable block (variable → default → purpose)
       instead of squeezing three columns — no scroll, no cramped mid-word wrapping. */
    .envtable thead {
      display: none;
    }
    .envtable,
    .envtable tbody,
    .envtable tr,
    .envtable td {
      display: block;
      width: 100%;
    }
    .envtable tr {
      padding: 0.75rem 0.9rem;
      border-bottom: 1px solid var(--hairline);
    }
    .envtable tbody tr:last-child {
      border-bottom: 0;
    }
    .envtable td {
      padding: 0;
      border: 0;
    }
    .envtable__name {
      white-space: normal;
      font-weight: 600;
    }
    .envtable__def {
      margin-top: 0.15rem;
    }
    .envtable__def::before {
      content: "default: ";
      color: var(--fg-faint);
    }
    .envtable__desc {
      margin-top: 0.35rem;
      min-width: 0;
    }
  }
</style>
