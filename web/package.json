{
  "name": "cairn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "description": "The embedded Cairn admin console: React 19 + Tailwind v4 + shadcn/ui, built with Vite into dist/ and embedded into the server binary by crates/cairn-web.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "e2e": "node scripts/console-e2e.mjs",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/browser-path-regression.mjs && node --experimental-strip-types --test scripts/download-filename.test.mjs",
    "test:performance": "node --test scripts/chrome-startup.test.mjs && node scripts/console-performance.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
